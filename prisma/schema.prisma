// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  image         String?
  username      String?
  bio           String?
  geminiApiKey  String?
  geminiModel   String?
  timezone      String?   // IANA zone, e.g. "Asia/Kolkata": AI wording, reports and the daily cron use it
  timezoneAuto  Boolean   @default(true) // false once picked by hand in Settings, so the browser stops overriding it
  aiProvider    String?   // 'gemini' | 'anthropic' | 'openai' | 'openrouter'
  youtubeApiKey String?   // YouTube Data API v3 key (falls back to YOUTUBE_API_KEY)
  creatorProfile Json?    // niche, audience, goals, posts per week, voice, topics to avoid (fed to the AI)
  aiRouting     Json?     // per-feature AI choice: { plan: { provider, model }, chat: {...} }
  goal          Json?     // { target, deadline? } for followers or subscribers
  setupDismissed Boolean  @default(false) // first-run checklist hidden
  dismissedAlerts Json?   // ids of alerts the creator closed
  notifyPrefs   Json?     // { digest: boolean, alerts: boolean } for push notifications
  notifiedAlerts Json?    // ids of alerts already sent as a push, so each goes out once
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  socialProfiles SocialProfile[]
  aiResults     AiResult[]
  aiCredentials AiCredential[]
  ideaThreads   IdeaThread[]
  savedIdeas    SavedIdea[]
  metaLink      MetaLink?
  competitors   Competitor[]
  aiUsage       AiUsage[]
  pushSubscriptions PushSubscription[]
}

model SocialProfile {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          String    // 'instagram' | 'facebook' | 'youtube'
  externalId        String?   // Platform's own ID, e.g. the YouTube channel ID
  username          String
  displayName       String
  profilePictureUrl String
  followerCount     Int
  isConnected       Boolean   @default(true)
  lastSyncedAt      DateTime  @default(now())
  accessToken       String?
  tokenExpiresAt    DateTime?
  audience          Json?     // Follower demographics from the platform, refreshed on sync
  reach30           Int?      // Unique accounts reached over the last 30 days (Instagram), refreshed on sync
  funnel            Json?     // 30-day profile visits, link taps, follows and unfollows (Instagram)
  posts             Post[]
  metrics           Metric[]
}

model Post {
  id               String         @id @default(uuid())
  socialProfileId  String
  socialProfile    SocialProfile  @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)
  thumbnail        String
  permalink        String?
  caption          String
  platform         String
  views            Int
  reach            Int?
  likes            Int
  comments         Int
  saves            Int
  shares           Int
  performanceScore Float
  isBoosted        Boolean  @default(false) // Promoted posts: platform insights cover organic results only
  publishedAt      DateTime
  type             String   // 'reel' | 'carousel' | 'post' | 'video' | 'short' | 'story'
  avgWatchMs       Int?     // reels: average watch time per play
  skipRate         Float?   // reels: % of plays skipped in the first seconds, when Instagram reports it
  ideas            SavedIdea[]
  snapshots        PostSnapshot[]
}

// A post's numbers at a point in its life (hours since posting), to draw growth curves
model PostSnapshot {
  id         String   @id // "<postId>:<hoursSincePost>"
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  hours      Int
  takenAt    DateTime @default(now())
  views      Int
  reach      Int?
  likes      Int
  comments   Int
  saves      Int
  shares     Int

  @@index([postId])
}

// One row per profile per day (id = "<profileId>:<yyyy-mm-dd>")
model Metric {
  id              String         @id @default(uuid())
  socialProfileId String
  socialProfile   SocialProfile  @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)
  date            DateTime
  followers       Int?
  views           Int?
  reach           Int?
  engagement      Float?
  postsCount      Int?
}

model SyncJob {
  id              String         @id @default(uuid())
  socialProfileId String?
  platform        String
  status          String         // 'pending' | 'running' | 'completed' | 'failed'
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  errorMessage    String?
}

// Cached AI output (insights, recommendations, game plan, report summaries) so pages load instantly
model AiResult {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // '<kind>:<scope>' or 'post:<id>'
  content   Json
  model     String
  createdAt DateTime @default(now())

  @@unique([userId, kind])
}

// One API key per AI provider; the active one is User.aiProvider
model AiCredential {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  apiKey    String
  model     String
  models    Json?    // Model ids this key can use, fetched when it was saved
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
}

// Ideas Studio: brainstorm conversations with the AI
model IdeaThread {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  scopeKey  String        @default("all")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  IdeaMessage[]
}

model IdeaMessage {
  id        String     @id @default(uuid())
  threadId  String
  thread    IdeaThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String     // 'user' | 'assistant'
  content   String
  model     String?
  createdAt DateTime   @default(now())
}

// Ideas the creator kept, moved along a small board
model SavedIdea {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  notes     String   @default("")
  format    String?
  status    String   @default("idea") // 'idea' | 'planned' | 'posted'
  source    String   @default("manual") // 'manual' | 'plan' | 'brainstorm' | 'recommendation'
  postId       String?  // the real post this idea became, to see how it did
  post         Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  scheduledFor DateTime? // planned date on the content calendar
  drafts       Json?    // AI-written script, carousel outline and caption
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Facebook Login link used only for Business Discovery (looking up other Instagram accounts)
model MetaLink {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String    // long-lived Facebook user token (about 60 days)
  expiresAt   DateTime?
  igUserId    String    // your Instagram professional account, linked to the Page
  igUsername  String
  pageName    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Public numbers of rival Instagram accounts, refreshed by sync
model Competitor {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username          String
  name              String?
  biography         String?
  profilePictureUrl String?
  followers         Int      @default(0)
  mediaCount        Int      @default(0)
  stats             Json?    // averages, cadence and format mix worked out from recent posts
  posts             Json?    // recent posts (caption, likes, comments, type, permalink, timestamp)
  error             String?
  lastSyncedAt      DateTime @default(now())
  createdAt         DateTime @default(now())
  history           CompetitorSnapshot[]

  @@unique([userId, username])
}

// One reading of a competitor per day, for growth lines
model CompetitorSnapshot {
  id           String     @id // "<competitorId>:<yyyy-mm-dd>"
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  date         DateTime
  followers    Int
  mediaCount   Int
  engagement   Float?
  postsPerWeek Float?

  @@index([competitorId])
}

// One row per AI answer, for the usage and cost view in Settings
model AiUsage {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cost         Float?   // USD, when known (Claude price list, or what OpenRouter reports)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// A browser or phone that asked for notifications (Web Push)
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  device    String?  // short label from the user agent, e.g. "Chrome on Android"
  createdAt DateTime @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// App-wide settings generated on first use, such as the Web Push (VAPID) key pair
model AppConfig {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}
