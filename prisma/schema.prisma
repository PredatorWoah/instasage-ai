// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  image         String?
  username      String?
  bio           String?
  geminiApiKey  String?
  geminiModel   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  socialProfiles SocialProfile[]
  aiResults     AiResult[]
}

model SocialProfile {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          String    // 'instagram' | 'facebook' | 'youtube'
  externalId        String?   // Platform's own ID, e.g. the YouTube channel ID
  username          String
  displayName       String
  profilePictureUrl String
  followerCount     Int
  isConnected       Boolean   @default(true)
  lastSyncedAt      DateTime  @default(now())
  accessToken       String?
  tokenExpiresAt    DateTime?
  audience          Json?     // Follower demographics from the platform, refreshed on sync
  posts             Post[]
  metrics           Metric[]
}

model Post {
  id               String         @id @default(uuid())
  socialProfileId  String
  socialProfile    SocialProfile  @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)
  thumbnail        String
  permalink        String?
  caption          String
  platform         String
  views            Int
  reach            Int?
  likes            Int
  comments         Int
  saves            Int
  shares           Int
  performanceScore Float
  publishedAt      DateTime
  type             String   // 'reel' | 'carousel' | 'post' | 'video' | 'story'
}

// One row per profile per day (id = "<profileId>:<yyyy-mm-dd>")
model Metric {
  id              String         @id @default(uuid())
  socialProfileId String
  socialProfile   SocialProfile  @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)
  date            DateTime
  followers       Int?
  views           Int?
  reach           Int?
  engagement      Float?
  postsCount      Int?
}

model SyncJob {
  id              String         @id @default(uuid())
  socialProfileId String?
  platform        String
  status          String         // 'pending' | 'running' | 'completed' | 'failed'
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  errorMessage    String?
}

// Cached Gemini output (insights, recommendations) so pages load instantly
model AiResult {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // 'insights' | 'recommendations'
  content   Json
  model     String
  createdAt DateTime @default(now())

  @@unique([userId, kind])
}
