# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instasage

# NextAuth: generate a secret with `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (sign-in + YouTube Data API v3, enable it in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Gemini for AI insights (skipped when unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
