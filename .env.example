# Copy to .env.local for local development. On Vercel, add the same names under
# Project Settings > Environment Variables. Never commit real values.

# ----- Required -----

# Postgres connection string (Neon, Prisma Postgres, Supabase or a local server)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instasage

# The one password that unlocks the dashboard (use something long)
APP_PASSWORD=

# NextAuth: any long random string (`openssl rand -base64 32`)
NEXTAUTH_SECRET=
# Your site's address. Vercel sets this automatically; needed locally
NEXTAUTH_URL=http://localhost:3000

# ----- Instagram ("Connect with Instagram") -----
# Meta app > Instagram > API setup with Instagram login > Set up Instagram business login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ----- Competitors (optional, Facebook Login for Business Discovery) -----
# Meta app > App settings > Basic (the main App ID and secret, not the Instagram ones)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Only for Business-type apps that use Facebook Login for Business configurations
FACEBOOK_LOGIN_CONFIG_ID=

# ----- YouTube (optional) -----
# Can also be pasted on the Accounts page instead. Google Cloud > YouTube Data API v3 > API key
YOUTUBE_API_KEY=

# ----- AI (optional) -----
# Keys for Gemini, Claude, ChatGPT and OpenRouter are pasted in Settings > AI models.
# These only provide a default Gemini key for the whole deployment.
GEMINI_API_KEY=
GEMINI_MODEL=

# ----- Daily auto-sync (Vercel Cron) -----
# Any long random string; Vercel sends it to /api/cron/sync and other callers are refused
CRON_SECRET=
