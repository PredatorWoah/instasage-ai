# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instasage

# Login password for the dashboard (use something long)
APP_PASSWORD=

# NextAuth: any long random string (`openssl rand -base64 32`)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# YouTube Data API v3 key from Google Cloud Console (APIs & Services > Credentials)
YOUTUBE_API_KEY=

# Optional: a Gemini key can be pasted in Settings instead. GEMINI_MODEL pins a model.
GEMINI_API_KEY=
GEMINI_MODEL=
