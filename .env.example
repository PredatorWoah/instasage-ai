# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instasage

# Login password for the dashboard (use something long)
APP_PASSWORD=

# NextAuth: any long random string (`openssl rand -base64 32`)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Instagram Business Login ("Connect with Instagram" button). From your Meta app:
# Instagram > API setup with Instagram login > Set up Instagram business login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# YouTube Data API v3 key from Google Cloud Console (APIs & Services > Credentials)
YOUTUBE_API_KEY=

# Optional: a Gemini key can be pasted in Settings instead. GEMINI_MODEL pins a model.
GEMINI_API_KEY=
GEMINI_MODEL=

# Daily auto-sync (Vercel Cron). Any long random string; Vercel sends it to /api/cron/sync
CRON_SECRET=
